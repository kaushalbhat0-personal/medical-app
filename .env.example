# Supabase: Dashboard → Project Settings → Database → Connection string → URI
# Use "Session mode" (recommended for SQLAlchemy server apps) or the pooler URI if you prefer.
# If the URI has no SSL query param, append ?sslmode=require (or &sslmode=require if it already has ?).

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment Configuration
DEBUG=false
ENVIRONMENT=production

# Production: enforced by startup validator — visit completion must send Idempotency-Key header.
REQUIRE_APPOINTMENT_COMPLETION_IDEMPOTENCY_KEY=true

# Optional: cache GET /api/v1/admin/integrity-scan (seconds; process-local).
# INTEGRITY_SCAN_CACHE_SECONDS=30
# Optional: tighter integrity scan throttle (default 12/min per user or IP).
# INTEGRITY_SCAN_RATE_LIMIT_PER_MINUTE=10

# Optional: Slack/Discord incoming webhook for integrity scan alerts and idempotency drift.
# INTEGRITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...


# CORS Configuration (comma-separated list of allowed origins)
# Production frontend URL - MUST include this for CORS to work
ALLOWED_ORIGINS=https://hospital-management-system-nine-topaz.vercel.app

# EMERGENCY DEBUG: Set to "*" to allow all origins (NOT for production)
# ALLOWED_ORIGINS=*

# Upstash Redis (REST) — shared slot cache. Copy HTTPS endpoint and token from the Upstash console.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
